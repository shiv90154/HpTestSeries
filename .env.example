# Postgres (Supabase Mumbai recommended; use the pooled connection string in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hp_test_series?schema=public"
# Only for local `npx prisma dev` (it serves one database per port): its shadow server URL
# SHADOW_DATABASE_URL=
# and set DATABASE_POOL_MAX=1 (it serves one connection at a time). Leave unset for real Postgres.
# DATABASE_POOL_MAX=
# BUILD_WORKERS=1   (same reason: local prisma dev only)

# Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://hptestseries.in

# Google sign-in (optional locally; the button is hidden when unset)
# Google Cloud Console → OAuth client (Web). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP login via Resend (optional locally; codes are printed to the server terminal when unset).
# Verify your domain in Resend first. EMAIL_FROM example: "HP Test Series <login@hptestseries.in>"
RESEND_API_KEY=
EMAIL_FROM=

# MSG91 OTP. Phone login is OFF by default; set PHONE_LOGIN=on only after MSG91 + DLT approval.
# PHONE_LOGIN=on
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Razorpay (Dashboard → Account & Settings → API Keys; use test keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://hptestseries.in/api/razorpay/webhook with events
# payment.captured, order.paid, payment.failed; paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=
# Shared secret for the reconcile cron (recovers payments whose webhook was missed). Generate like BETTER_AUTH_SECRET.
CRON_SECRET=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics loads only when set — it's baked in at build time.
NEXT_PUBLIC_GA_ID=
# Search Console HTML-tag verification code (content="…" value). Not needed if you verified via DNS.
# GOOGLE_SITE_VERIFICATION=

# Added in later phases (see docs/BLUEPRINT.md):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
