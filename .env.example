# Postgres (Supabase Mumbai recommended; use the pooled connection string in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hp_test_series?schema=public"
# Only for local `npx prisma dev` (it serves one database per port): its shadow server URL
# SHADOW_DATABASE_URL=
# and set DATABASE_POOL_MAX=1 (it serves one connection at a time). Leave unset for real Postgres.
# DATABASE_POOL_MAX=
# BUILD_WORKERS=1   (same reason: local prisma dev only)

# Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://hptestseries.in

# Google sign-in (optional locally; the button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MSG91 OTP (optional locally; OTPs are printed to the server terminal when unset)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Added in later phases (see docs/BLUEPRINT.md):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
